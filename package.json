{
  "name": "homebridge-wol-tv",
  "displayName": "WOL TV",
  "version": "1.0.1",
  "description": "Expose Wake-on-LAN computers as Apple Home televisions with real power state monitoring.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": "./dist/index.js",
  "files": [
    "dist",
    "config.schema.json",
    "config.example.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "wake-on-lan",
    "wol",
    "television",
    "homekit"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^2.0.0"
  },
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.js",
    "prepack": "npm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ajv": "^8.17.1",
    "homebridge": "^2.5.0",
    "typescript": "^7.0.2"
  }
}
